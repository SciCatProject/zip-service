{
  "routeBasePath": "<BASE_URL_PREFIX>",
  "publicOrigin": "<BASE_URL>",
  "formViewsEnabled": {
    "file": false,
    "zip": false,
    "index": false
  },
  "zipDir": "<tmpZipStorage>",
  "jwtSecret": "<dev_secret>",
  "sessionSecret": "<dev_secret>",
  "facility": "<FACILITY>",
  "zipRetentionMillis": 3600000,
  "fileLinkRetentionMillis": 3600000,
  "allowedDataDirectory": "/<dataSource>",
  "maxResolvedPathCandidates": 1000,
  "directoryPathPattern": "/<dataSource>/{{ @keywords }}/{{ @instrumentIds }}/{{ @proposalIds }}/{{ @type }}",
  "requiredDatasetVariables": [
    "keywords",
    "instrumentIds",
    "proposalIds",
    "type"
  ],
  "hdfViewServiceUrl": "<HDF_VIEWER_URL>",
  "testData": {
    "jwt": "<TEST_TOKEN>",
    "files": [
      "test_file_1.txt"
    ]
  },
  "graylogEnabled": false,
  "graylogServer": "<GREYLOG_SERVER_URL>",
  "graylogPort": 12201,
  "environment": "development",
  "scicatApiBasePath": "<SCICAT_API_URL>",
  "scicatApiAccessToken": "<SCICAT_TOKEN>",
  "uploadEnabled": false
}
