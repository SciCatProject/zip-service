<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,shrink-to-fit=no"
    />
    <link rel="stylesheet" type="text/css" href="<%= routeBasePath %>/css/index.css" />
    <title>zip-service</title>
  </head>
  <body>
    <div class="container">
      <h2 style="padding-left: 1em">Zip-service</h2>
      <div class="flex-container">
        <div
          class="flex-panel-item"
          style="font-style: italic; font-size: 0.8em;"
        >
          <p>
            UI for testing zip-service. While implementation details of file
            authorization may vary between facilities, a valid jwt (JSON Web
            Token) is required. This can be specified either as a cookie, a url
            parameter for download requests, or in a POST body.
          </p>
          <p>
            Use the zip form to create a zip archive from several files, or the
            file form to create a temporary download/stream link for one file.
          </p>
        </div>
        <div class="flex-panel-item form-stack">
          <h3>Forms</h3>
          <p><a class="button-link" href="<%= routeBasePath %>/zip">Zip files</a></p>
          <p><a class="button-link" href="<%= routeBasePath %>/file">Single file</a></p>
        </div>
      </div>
    </div>
  </body>
</html>
